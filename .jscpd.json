{
  "threshold": 5,
  "min-lines": 10,
  "min-tokens": 50,
  "reporters": [
    "console",
    "json"
  ],
  "output": "build/jscpd",
  "ignore": [
    "**/build/**",
    "**/.build/**",
    "**/Pods/**",
    "**/DerivedData/**",
    "**/*.xcstrings",
    "**/*.json",
    "**/env/**",
    "**/.git/**",
    "**/Tests/**",
    "**/Generated/**"
  ],
  "absolute": true
}
