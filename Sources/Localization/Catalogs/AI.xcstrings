      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When synthesizing, cite source pages using [[Page Title]] format. Only state facts grounded in the provided content. Do not fabricate information not present in the sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合成时请使用 [[页面标题]] 格式注明来源。仅陈述源材料中可验证的事实，禁止编造不存在的信息。"
