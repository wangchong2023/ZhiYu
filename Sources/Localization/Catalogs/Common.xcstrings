    "demo.welcome.card.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-click to ask the AI assistant the preset RAG query for this notebook and experience the \"Aha Moment\" of deep citation!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键向 AI 助手提问该笔记本的预设 RAG 检索问题，即刻体验深度引用的“魔法时刻”！"
          }
        },
