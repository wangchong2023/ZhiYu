    "ingest.aiTagPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze the following web content. Extract: 1) Alias title (3-15 chars) 2) Category tags (1-3, comma-separated).\n\nContent:\n%@\n\nReturn JSON: {\"aliasTitle\": \"...\", \"tags\": [\"tag1\", \"tag2\"]}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分析以下网页内容，提取：1) 别名标题（3-15字）2) 分类标签（1-3个，逗号分隔）。\n\n内容：\n%@\n\n请以 JSON 格式返回：{\"aliasTitle\": \"...\", \"tags\": [\"标签1\", \"标签2\"]}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請分析以下網頁內容，提取：1) 別名標題（3-15字）2) 分類標籤（1-3個，逗號分隔）。\n\n內容：\n%@\n\n請以 JSON 格式返回：{\"aliasTitle\": \"...\", \"tags\": [\"標籤1\", \"標籤2\"]}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze the following web content. Extract: 1) Alias title (3-15 chars) 2) Category tags (1-3, comma-separated).\n\nContent:\n%@\n\nReturn JSON: {\"aliasTitle\": \"...\", \"tags\": [\"tag1\", \"tag2\"]}"
          }
        },
