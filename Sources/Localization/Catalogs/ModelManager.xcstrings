    "model_manager.lab.response.mobile_action_unauthorized_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschuldigung, die lokale Sandbox unterstützt nur Taschenlampe, Haptik und Benachrichtigungen. \"%1$@\" ist nicht autorisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, on-device sandbox only supports flashlight, haptics, and notifications. \"%1$@\" is not authorized."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo siento, el sandbox local solo admite linterna, háptica y notificaciones. \"%1$@\" no está autorizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé, la sandbox locale ne prend en charge que la lampe, les retours haptiques et les notifications. \"%1$@\" n'est pas autorisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申し訳ありません。ローカルサンドボックスでは現在、懐中電灯、触覚フィードバック、通知のみ対応しています。「%1$@」は許可されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죄송합니다. 온디바이스 샌드박스는 손전등, 햅틱 및 알림만 지원합니다. \"%1$@\" 명령은 승인되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpe, a sandbox local suporta apenas lanterna, resposta tátil e notificações. \"%1$@\" não está autorizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К сожалению, локальная песочница поддерживает только фонарик, тактильный отклик и уведомления. Действие \"%1$@\" не авторизовано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，当前端侧沙盒环境仅支持调度手电筒、触感马达和本地通知，指令“%1$@”未获得系统授权。"
