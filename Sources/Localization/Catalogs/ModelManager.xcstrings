    "model_manager.lab.vision.question_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Ihrer Frage „%@“: Obige Angaben wurden vom Modell tatsächlich aus den Bildpixeln extrahiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarding your question \"%@\": the above was actually extracted from the image pixels by the on-device vision model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre su pregunta «%@»: lo anterior se extrajo realmente de los píxeles de la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concernant votre question « %@ » : ce qui précède a été réellement extrait des pixels de l'image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riguardo alla domanda «%@»: quanto sopra è stato estratto realmente dai pixel dell'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご質問「%@」について: 上記は画像のピクセルから実際に抽出された結果です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 \"%@\"에 대해: 위 내용은 이미지 픽셀에서 실제로 추출된 결과입니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre a sua pergunta «%@»: o acima foi realmente extraído dos píxeis da imagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对您的提问“%@”：以上为端侧视觉模型从图像像素中实际提取的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "針對您的提問「%@」：以上為端側視覺模型從圖像像素中實際提取的結果。"
          }
        }
      }
    },
