    "model_manager.lab.audio.sample.tech_text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für hybride Multimedia-Suchaufgaben haben visuelle und textuelle On-Device-Einbettungsmodelle einen 768-dimensionalen semantischen Abgleich abgeschlossen und berechnen die Kosinusähnlichkeit in Millisekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For multimedia hybrid retrieval tasks, on-device vision and text embedding models have completed 768-dim feature space semantic alignment, computing cosine similarity in milliseconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la búsqueda híbrida multimedia, los modelos de incrustación de visión y texto en dispositivo completaron la alineación semántica en 768 dimensiones, calculando la similitud coseno en milisegundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la recherche hybride multimédia, les modèles d'intégration visuelle et textuelle sur l'appareil ont terminé l'alignement sémantique spatial à 768 dimensions, calculant la similarité cosinus en millisecondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la ricerca ibrida multimediale, i modelli di incorporamento visivo e testuale su dispositivo hanno completato l'allineamento semantico a 768 dimensioni, calcolando la similarità del coseno in millisecondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチメディアハイブリッド検索タスクにおいて端末ビジョンおよびテキスト埋め込みモデルは768次元の特徴空間意味整合を完了しミリ秒単位でコサイン類似度を計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티미디어 하이브리드 검색 작업을 위해 온디바이스 비전 및 텍스트 임베딩 모델이 768차원 특징 공간 의미 정렬을 완료하여 밀리초 단위로 코사인 유사도를 계산합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a pesquisa híbrida de multimédia, os modelos de incorporação visual e de texto no dispositivo concluíram o alinhamento semântico de 768 dimensões, calculando a similaridade de cosseno em milissegundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对多媒体混合检索任务，端侧视觉与文本嵌入模型现已完成 768 维特征空间的语义对齐。以文搜图在毫秒级内完成余弦相似度计算并实时渲染排序结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "針對多媒體混合檢索任務，端側視覺與文本嵌入模型現已完成 768 維特徵空間的語義對齊。以文搜圖在毫秒級內完成餘弦相似度計算並即時渲染排序結果。"
          }
        }
      }
    },
