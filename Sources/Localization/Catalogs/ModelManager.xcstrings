    "use_case_benchmark_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messen Sie die TTFT-Latenz auf dem Gerät, den Dekodierungsdurchsatz (Tokens/s) und den maximalen Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure on-device TTFT latency, decode throughput (tokens/s), and peak memory footprint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida la latencia TTFT en el dispositivo, el rendimiento de decodificación (tokens/s) y la memoria máxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurer la latence TTFT sur l'appareil, le débit de décodage (tokens/s) et la mémoire de crête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura la latenza TTFT sul dispositivo, la velocità di decodifica (token/s) e la memoria di picco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上のTTFT遅延、デコードスループット（トークン/秒）、ピークメモリを測定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 TTFT 지연 시간, 디코딩 처리량(초당 토큰 수), 최대 메모리를 측정합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça a latência TTFT no dispositivo, o débito de descodificação (tokens/s) e a memória máxima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量端侧首字延迟 (TTFT)、解码生成速度 (TPS) 与峰值显存/内存增量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
