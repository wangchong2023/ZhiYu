    "model_manager.lab.model_loading_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokalen Modellgewichte sind in der Sandbox bereit. Die Neural Engine initialisiert die Speicherzuordnung. Bitte versuchen Sie es in Kürze erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model weights are ready in the sandbox. The Apple Neural Engine is mapping weights and allocating memory. Please try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pesos del modelo local están listos en el sandbox. El Neural Engine está asignando memoria. Vuelva a intentarlo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les poids du modèle local sont prêts dans le bac à sable. Le Neural Engine alloue la mémoire. Veuillez réessayer sous peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pesi del modello locale sono pronti nella sandbox. Il Neural Engine sta allocando la memoria. Riprova a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルの重みはサンドボックスに準備完了しています。Neural Engineがメモリを割り当てています。しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델 가중치가 샌드박스에 준비되었습니다. Neural Engine이 메모리를 매핑하고 있습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pesos do modelo local estão prontos no sandbox. O Neural Engine está a alocar memória. Tente novamente em breve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端侧本地大模型权重已在设备沙盒就绪。端侧神经网络引擎（ANE）正在完成权重映射与运行内存分配，请稍候点击重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端側本地大模型權重已在設備沙盒就緒。端側神經網絡引擎（ANE）正在完成權重映射與運行內存分配，請稍候點擊重試。"
          }
        }
      }
    },
