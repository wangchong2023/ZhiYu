    "model_manager.lab.model_not_ready_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Lab ist ausschließlich für On-Device-Offline-Modelle konzipiert und läuft vollständig lokal ohne Online-APIs. Die ausgewählten Modellgewichte sind noch nicht heruntergeladen. Bitte laden Sie sie unter Modell-Downloads herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Lab is dedicated to evaluating on-device offline models, running strictly on your device without online APIs. The selected local model weights are not downloaded yet. Please download them in Model Downloads to start offline testing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Lab está dedicado a evaluar modelos locales sin conexión, ejecutándose completamente en el dispositivo sin APIs en línea. Los pesos del modelo seleccionado aún no se han descargado. Descárguelos en Descargas de Modelos para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Lab est dédié à l’évaluation de modèles hors ligne sur l’appareil, s’exécutant entièrement en local sans API en ligne. Les poids du modèle sélectionné ne sont pas encore téléchargés. Veuillez les télécharger dans Téléchargements de modèles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Lab è dedicato alla valutazione di modelli offline su dispositivo, funzionando interamente in locale senza API online. I pesi del modello selezionato non sono ancora scaricati. Scaricali in Download Modelli per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Labは端末内オフラインモデル専用の評価環境であり、オンラインAPIを使わず完全にローカルで動作します。選択したモデルの重みファイルがまだダウンロードされていません。「モデルダウンロード」からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZhiYu Model Lab은 온디바이스 오프라인 모델 전용 평가 환경으로, 온라인 API를 거치지 않고 완전히 로컬에서 실행됩니다. 선택한 로컬 모델 가중치가 아직 다운로드되지 않았습니다. 모델 다운로드에서 다운로드한 후 사용해 주세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ZhiYu Model Lab dedica-se à avaliação de modelos offline no dispositivo, funcionando estritamente a nível local sem APIs online. Os pesos do modelo selecionado ainda não foram descarregados. Transfira-os em Descargas de Modelos para começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇模型实验室专用于端侧离线大模型的评测与体验，完全在设备本地运行且不走在线云端。当前选中的本地模型权重尚未下载，请前往「模型下载」页面下载该离线权重后即可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智宇模型實驗室專用於端側離線大模型的評測與體驗，完全在設備本地運行且不走在線雲端。當前選中的本地模型權重尚未下載，請前往「模型下載」頁面下載該離線權重後即可使用。"
          }
        }
      }
    },
