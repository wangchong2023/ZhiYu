    "model_manager.lab.audio.sample.meeting_text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige technische Überprüfung konzentrierte sich auf die 4-Bit-Quantisierungsbeschleunigung für On-Device-LLMs. Wir haben eine TTFT von unter 200 ms auf der ANE erreicht bei stabilem Speicher unter 2,3 GB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This afternoon technical review focused on on-device LLM 4-bit quantization acceleration. We achieved sub-200ms TTFT on the ANE neural engine with memory usage stable under 2.3 GB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión técnica de esta tarde se centró en la aceleración de cuantificación de 4 bits para LLM en dispositivo. Logramos un TTFT inferior a 200 ms en el motor ANE con memoria estable por debajo de 2,3 GB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La revue technique de cet après-midi a porté sur l'accélération de la quantification 4 bits des LLM sur l'appareil. Nous avons atteint un TTFT inférieur à 200 ms sur l'ANE avec une mémoire stable sous 2,3 Go."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisione tecnica di questo pomeriggio si è concentrata sull'accelerazione della quantizzazione a 4 bit dei LLM su dispositivo. Abbiamo ottenuto un TTFT inferiore a 200 ms su ANE con memoria stabile sotto i 2,3 GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の技術レビューはオンデバイスLLMの4ビット量子化加速に焦点を当てました。ANE上でTTFT 200ms未満を達成しメモリ使用量は2.3GB未満で安定しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 오후 기술 리뷰는 온디바이스 LLM 4비트 양자화 가속에 집중되었습니다. ANE 신경망 엔진에서 200ms 미만의 TTFT를 달성했고 메모리는 2.3GB 이하로 안정적입니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise técnica desta tarde focou-se na aceleração da quantização de 4 bits para LLMs no dispositivo. Alcançámos um TTFT inferior a 200 ms no ANE com memória estável abaixo de 2,3 GB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天下午技术评审聚焦在端侧大模型 4-bit 量化加速方案。我们在 ANE 神经网络引擎上实现了首字延迟低于两百毫秒的优异表现，内存占用稳定在两点三吉字节以内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天下午技術評審聚焦在端側大模型 4-bit 量化加速方案。我們在 ANE 神經網絡引擎上實現了首字延遲低於兩百毫秒的優異表現，內存佔用穩定在兩點三吉字節以內。"
          }
        }
      }
    },
