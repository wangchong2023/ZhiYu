    "model_manager.lab.audio.sample.schedule_text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung: Morgen um 10 Uhr Durchsprache der multimodalen visuellen QA-Erfahrung mit dem Produktteam, mit Fokus auf Speicherpeaks und cross-modale Ausrichtung beim Fotoimport."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder: Walk through multimodal visual QA experience with the product team tomorrow at 10 AM, focusing on peak memory and cross-modal alignment when importing photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio: Revisar la experiencia de preguntas y respuestas visuales multimodales con el equipo mañana a las 10:00, evaluando el pico de memoria y la alineación cruzada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel : Revue de l'expérience de questions-réponses visuelles multimodales avec l'équipe produit demain à 10 h, axée sur la mémoire de crête et l'alignement cross-modal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria: revisione dell'esperienza QA visiva multimodale con il team domani alle 10:00, con focus sul picco di memoria e sull'allineamento cross-modale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー：明日の午前10時に製品チームとマルチモーダル視覚QA体験を確認し、写真読み込み時のメモリピークとクロスモーダル整合性を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림: 내일 오전 10시 제품 팀과 멀티모달 시각 QA 경험을 검토하며 고화질 사진을 가져올 때의 메모리 피크와 크로스모달 정렬 품질을 검증합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete: Rever a experiência de perguntas e respostas visuais multimodais com a equipa amanhã às 10:00, com foco no pico de memória e alinhamento cross-modal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒明天上午十点与产品团队走查多模态视觉问答体验，重点验证从相册导入高清图片时的内存峰值与图文跨模态对齐质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒明天上午十點與產品團隊走查多模態視覺問答體驗，重點驗證從相冊導入高清圖片時的內存峰值與圖文跨模態對齊質量。"
          }
        }
      }
    },
