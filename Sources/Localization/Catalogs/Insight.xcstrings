    "dashboard.stats.tipRetrievalPhase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full pipeline of finding relevant documents from the knowledge base, including vector search, semantic matching, and result ranking. Measures retrieval hit rate, coverage, and response speed."
          }
