    "dashboard.stats.tipNDCG": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalized Discounted Cumulative Gain. A ranking-quality metric that gives higher weight to relevant docs appearing earlier in the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归一化折损累计增益。考虑排序位置权重的排序质量指标，位置越靠前的相关文档得分越高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸一化折損累计增益。考慮排序位置權重的排序質量指標，位置越靠前的相關文档得分越高。"
          }
        },
        "es": {
