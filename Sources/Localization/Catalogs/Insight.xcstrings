    "dashboard.stats.tipMRR": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mean Reciprocal Rank. Average of the reciprocal of the rank where the first relevant doc appears. Higher means better positioning of relevant results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均倒数排名。第一个相关文档在结果中排名的倒数取平均，越高说明检索将相关结果排得越靠前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平均倒數排名。第一個相關文档在結果中排名的倒數取平均，越高說明检索將相關結果排得越靠前。"
          }
        },
        "es": {
