# .gitignore for ZhiYu (Swift/Xcode/macOS)

# Xcode
xcuserdata/
MostRecentCompletionIndex
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcworkspace/contents.xcworkspacedata
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.moved-aside
*.p_t

# Build results
/build/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Other
*.log
scratch/
env/

# Claude Code
.codegraph/

# CodeFree 安全审计产物
.codefree/
codefree-code-review/
security-check/

# Temporary log/pid files
/tmp/*.log
/tmp/*.pid
/tmp/mock_*.pid

# 插件源文件 — 仅在 Tools/Plugins/ 下管理，禁止根目录散落
/*.zyplugin

# VS Code 统计工具输出
.VSCodeCounter/

# 第三方 AI 助手遗留
.workbuddy/

# Python 缓存
__pycache__/

# SonarQube 扫描缓存
.scannerwork/

# 临时测试数据目录
Configs/
zhiyu-releases/

# 本地环境配置（包含机器相关绝对路径，不提交）
Config/.env.local

# project.yml 由 bootstrap.sh 从 Config/project.yml.template 生成，不提交
# 提交的是模板：Config/project.yml.template
project.yml
.exemption_cache/
sonar-coverage.xml

# 独立的嵌套创新项目（与 ZhiYu 主工程无关，不纳入仓库）
cip-innovation/

# IDL 契约层生成产物（Phase 0 收缩：契约止于 proto+gen.sh，生成代码不提交）
# 运行 Tools/contracts/gen.sh 时按需再生成
Sources/Domain/Contracts/Generated/

# 误提交的编译产物二进制（原为工具构建输出，非项目源码）
/main

# SPM 本地包构建产物（swift test --package-path 输出，非源码）
Packages/*/build/
