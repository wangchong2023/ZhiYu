# .gitignore for ZhiYu (Swift/Xcode/macOS)

# Xcode
xcuserdata/
MostRecentCompletionIndex
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcworkspace/contents.xcworkspacedata
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
DerivedData/
*.moved-aside
*.p_t

# Build results
/build/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Other
*.log
scratch/
env/

# Claude Code
.codegraph/

# CodeFree 安全审计产物
.codefree/
codefree-code-review/

# Temporary log/pid files
/tmp/*.log
/tmp/*.pid
/tmp/mock_*.pid

# 插件源文件 — 仅在 Tools/Plugins/ 下管理，禁止根目录散落
/*.zyplugin

# VS Code 统计工具输出
.VSCodeCounter/

# 第三方 AI 助手遗留
.workbuddy/

# Python 缓存
__pycache__/

# SonarQube 扫描缓存
.scannerwork/

# 临时测试数据目录
Configs/
zhiyu-releases/

# 本地环境配置（包含机器相关绝对路径，不提交）
Config/.env.local

# project.yml 由 bootstrap.sh 从 Config/project.yml.template 生成，不提交
# 提交的是模板：Config/project.yml.template
project.yml
.exemption_cache/
sonar-coverage.xml
